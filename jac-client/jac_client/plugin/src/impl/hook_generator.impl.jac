"""Initialize the HookGenerator."""
impl HookGenerator.init(self: HookGenerator, output_dir: Path) {
    self.output_dir = output_dir;
}

"""Convert walker name to React hook name (e.g., read_todos -> useReadTodos)."""
impl HookGenerator._to_hook_name(self: HookGenerator, walker_name: str) -> str {
    # Split by underscore and capitalize each part
    parts = walker_name.split('_');
    capitalized = ''.join(part.capitalize() for part in parts);
    return f"use{capitalized}";
}

"""Generate a useQuery hook for a query walker."""
impl HookGenerator._generate_query_hook(
    self: HookGenerator, metadata: WalkerQueryMetadata, fields: list[str]
) -> str {
    hook_name = self._to_hook_name(metadata.walker_name);
    query_key = metadata.key if metadata.key else [metadata.walker_name];
    query_key_str = str(query_key).replace("'", '"');

    # Build options object
    options_parts: list[str] = [];
    if metadata.stale_time is not None {
        options_parts.append(f"    staleTime: {metadata.stale_time}");
    }
    if metadata.refetch_interval is not None {
        options_parts.append(f"    refetchInterval: {metadata.refetch_interval}");
    }
    options_str = "";
    if options_parts {
        options_str = ",\n" + ",\n".join(options_parts);
    }

    # Generate args type if walker has fields
    args_type = "";
    args_param = "";
    args_spread = "{}";
    if fields {
        type_parts = [f"{f}: any" for f in fields];
        args_type = f"args?: {{ {', '.join(type_parts)} }}";
        args_param = f"args?: {{ {', '.join(type_parts)} }}";
        args_spread = "args || {}";
    }

    hook_code = f'''
/**
 * Auto-generated query hook for {metadata.walker_name} walker.
 * Query key: {query_key_str}
 */
export function {hook_name}({args_param}) {{
  return useQuery({{
    queryKey: {query_key_str},
    queryFn: async () => {{
      const result = await __jacSpawn("{metadata.walker_name}", "", {args_spread});
      return result.reports || result;
    }}{options_str}
  }});
}}
''';
    return hook_code;
}

"""Generate a useMutation hook for a mutation walker."""
impl HookGenerator._generate_mutation_hook(
    self: HookGenerator, metadata: WalkerQueryMetadata, fields: list[str]
) -> str {
    hook_name = self._to_hook_name(metadata.walker_name);

    # Build invalidation code
    invalidate_code = "";
    if metadata.invalidates {
        invalidate_lines: list[str] = [];
        for key in metadata.invalidates {
            key_str = f'["{key}"]' if isinstance(key, str) else str(key).replace("'", '"');
            invalidate_lines.append(f'      queryClient.invalidateQueries({{ queryKey: {key_str} }});');
        }
        invalidate_code = "\n".join(invalidate_lines);
    }

    # Generate args type if walker has fields
    args_type = "void";
    if fields {
        type_parts = [f"{f}: any" for f in fields];
        args_type = f"{{ {', '.join(type_parts)} }}";
    }

    # Build optimistic update code if enabled
    optimistic_code = "";
    if metadata.optimistic and metadata.invalidates {
        # For optimistic updates, we cancel queries and can provide rollback
        first_key = metadata.invalidates[0] if metadata.invalidates else metadata.walker_name;
        key_str = f'["{first_key}"]' if isinstance(first_key, str) else str(first_key).replace("'", '"');
        optimistic_code = f'''
    onMutate: async (variables) => {{
      await queryClient.cancelQueries({{ queryKey: {key_str} }});
      const previousData = queryClient.getQueryData({key_str});
      return {{ previousData }};
    }},
    onError: (err, variables, context) => {{
      if (context?.previousData) {{
        queryClient.setQueryData({key_str}, context.previousData);
      }}
    }},''';
    }

    hook_code = f'''
/**
 * Auto-generated mutation hook for {metadata.walker_name} walker.
 * Invalidates: {metadata.invalidates}
 * Optimistic: {metadata.optimistic}
 */
export function {hook_name}() {{
  const queryClient = useQueryClient();
  return useMutation({{
    mutationFn: async (args: {args_type}) => {{
      const result = await __jacSpawn("{metadata.walker_name}", "", args || {{}});
      return result.reports?.[0] || result;
    }},{optimistic_code}
    onSuccess: () => {{
{invalidate_code}
    }}
  }});
}}
''';
    return hook_code;
}

"""Generate all hooks from manifest and return combined code."""
impl HookGenerator.generate_hooks(self: HookGenerator, manifest: ClientManifest) -> str {
    if not manifest.walker_queries {
        return "";
    }

    # Build the hooks file with imports
    hooks_code = '''/**
 * Auto-generated React Query hooks for Jac walkers.
 * DO NOT EDIT - This file is generated by jac-client.
 */
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { __jacSpawn } from "./client_runtime";

''';

    for (walker_name, metadata) in manifest.walker_queries.items() {
        fields = manifest.params.get(walker_name, []);

        if metadata.query_type == "query" {
            hooks_code += self._generate_query_hook(metadata, fields);
        } elif metadata.query_type == "mutation" {
            hooks_code += self._generate_mutation_hook(metadata, fields);
        }
    }

    return hooks_code;
}

"""Write hooks to file and return the path."""
impl HookGenerator.write_hooks_file(self: HookGenerator, hooks_code: str) -> Path {
    if not hooks_code {
        return None;
    }

    self.output_dir.mkdir(parents=True, exist_ok=True);
    hooks_file = self.output_dir / 'generated_hooks.js';
    hooks_file.write_text(hooks_code, encoding='utf-8');
    return hooks_file;
}
